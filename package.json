{
  "name": "leetcode-sr",
  "private": true,
  "type": "module",
  "version": "1.1.2",
  "author": "Vig",
  "description": "Windows desktop app for NeetCode 150 spaced repetition: daily reviews, goal-date pacing, offline SQLite progress — no cloud or account.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "rebuild": "cd node_modules/better-sqlite3 && npx prebuild-install -r electron -t 42.6.1",
    "stress": "node -e \"try{require('fs').rmSync('.tmp-stress',{recursive:true,force:true})}catch(e){}\" && npx esbuild scripts/stress-test.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=scripts/stress-test.cjs && set LEETCODE_SR_DATA_DIR=.tmp-stress&& set ELECTRON_RUN_AS_NODE=1&& electron scripts/stress-test.cjs",
    "predist": "npm run rebuild && node -e \"try{require('child_process').execSync('taskkill /F /IM \\\"LeetCode - Spaced Repetition.exe\\\"',{stdio:'ignore'})}catch(e){}\"",
    "dist": "npm run build && electron-builder",
    "dist:publish": "npm run build && electron-builder --publish always",
    "postdist": "node -e \"const fs=require('fs');const{execSync}=require('child_process');const path=require('path');const z=path.resolve('release/LeetCode-Spaced-Repetition-win-x64.zip');try{fs.rmSync(z,{force:true})}catch(e){};execSync('tar -a -c -f \\\"'+z+'\\\" -C release/win-unpacked .',{stdio:'inherit'});console.log('wrote',z)\""
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "42.6.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
