{
  "appId": "com.vig.leetcode-sr",
  "productName": "LeetCode - Spaced Repetition",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": ["dist/**", "dist-electron/**"],
  "asarUnpack": ["**/*.node"],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      "portable",
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "LeetCode-Spaced-Repetition.exe"
  }
}
